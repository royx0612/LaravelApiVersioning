{
    "name": "royx0612/laravel-api-versioning",
    "description": "Laravel API 版本控制器生成工具",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Royx0612"
        }
    ],
    "require": {
        "php": "^8.1",
        "laravel/framework": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Royx0612\\LaravelApiVersioning\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Royx0612\\LaravelApiVersioning\\ApiVersioningServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}